# ---------------------------------------------------------------------------
# AgroConecta - Variables de entorno de ejemplo
# Copia este archivo como .env y ajusta los valores segun tu entorno.
# ---------------------------------------------------------------------------

# ---- Base de datos PostgreSQL ----
POSTGRES_DB=agroconecta
POSTGRES_USER=agroconecta
POSTGRES_PASSWORD=agroconecta
POSTGRES_PORT=5432

# ---- Backend (Spring Boot) ----
DB_URL=jdbc:postgresql://localhost:5432/agroconecta
DB_USER=agroconecta
DB_PASSWORD=agroconecta
SERVER_PORT=8080
# Secreto para firmar los JWT (minimo 32 caracteres). Cambialo en produccion.
JWT_SECRET=cambia-este-secreto-de-desarrollo-agroconecta-2026
JWT_EXPIRATION_MS=86400000
# Origenes permitidos para CORS (separados por coma).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# ---- Frontend (Vite) ----
# Ruta base de la API consumida por el navegador.
VITE_API_URL=/api
